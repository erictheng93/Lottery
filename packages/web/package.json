{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "bun run build && wrangler pages dev dist",
    "deploy": "bun run build && wrangler pages deploy dist",
    "db:init:local": "wrangler d1 execute lottery-db --local --file=../core/db/schema.sql",
    "db:init:remote": "wrangler d1 execute lottery-db --remote --file=../core/db/schema.sql"
  },
  "dependencies": {
    "@lottery/core": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.102.0"
  }
}
